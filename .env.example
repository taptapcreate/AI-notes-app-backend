# Environment Variables
# Get your Gemini API key from: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000

# MongoDB Atlas Connection
# Get your connection string from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/ai-notes-app?retryWrites=true&w=majority

# RevenueCat Webhook Secret
# Create a random secret and set it in RevenueCat Dashboard > Integrations > Webhooks
REVENUECAT_WEBHOOK_SECRET=your_random_secret_here

# RevenueCat API Secret Key (for purchase sync)
# Get this from RevenueCat Dashboard > Project Settings > API Keys > Secret API key
REVENUECAT_API_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx
