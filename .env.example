# Environment Variables
PORT=3000

# MongoDB Atlas Connection
# Get your connection string from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/ai-notes-app?retryWrites=true&w=majority

# RevenueCat Webhook Secret
# Create a random secret and set it in RevenueCat Dashboard > Integrations > Webhooks
REVENUECAT_WEBHOOK_SECRET=your_random_secret_here

# RevenueCat API Secret Key (for purchase sync)
# Get this from RevenueCat Dashboard > Project Settings > API Keys > Secret API key
REVENUECAT_API_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Leave blank until Apple's new pack quantities go live. Use the confirmed ISO timestamp
# with zone, e.g. 2026-01-01T00:00:00Z. Use the quantity cutover, not the backend deploy date.
APPLE_CREDIT_PACKS_EFFECTIVE_AT=

# Required for purchase support/admin endpoints (use a distinct random secret).
ADMIN_API_SECRET=your_random_admin_secret_here

# Keep false on production. Enable only for an isolated sandbox environment.
REVENUECAT_ALLOW_SANDBOX=false

# OpenRouter key used for note and reply generation, PDF processing, and voice transcription
OPEN_ROUTER_API_KEY=your_openrouter_api_key_here

# Number of ingress proxies, verified on the deployed Render service. Direct local server: 0.
TRUST_PROXY_HOPS=0

# Optional workplace OAuth. Generate a unique 32-byte hex key and keep it stable across instances.
# Register this exact HTTPS callback with each provider before enabling it.
WORKPLACE_OAUTH_CALLBACK=
WORKPLACE_OAUTH_KEY=
WORKPLACE_MICROSOFT_CLIENT_ID=
WORKPLACE_MICROSOFT_CLIENT_SECRET=
WORKPLACE_JIRA_CLIENT_ID=
WORKPLACE_JIRA_CLIENT_SECRET=
WORKPLACE_ZOHO_CLIENT_ID=
WORKPLACE_ZOHO_CLIENT_SECRET=
# For Zoho multi-DC, set WORKPLACE_ZOHO_CLIENT_SECRET_<REGION> when a region uses a separate secret.
